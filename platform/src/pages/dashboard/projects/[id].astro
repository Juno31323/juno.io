---
import Shell from '../../../layouts/Shell.astro';
import ImageUpload from '../../../components/ImageUpload.astro';
import {ownerData} from '../../../lib/server';
const info=await ownerData(Astro.locals.db!,Astro.locals.user!.id);if(!info.profile)return Astro.redirect('/dashboard/');
const isNew=Astro.params.id==='new',p=isNew?null:info.projects.find(p=>p.id===Astro.params.id);
if(!isNew&&!p)return Astro.redirect('/dashboard/projects/');
---
<Shell title={p?`${p.title} 편집`:'새 프로젝트'} dashboard noindex><header class="page-heading"><a class="back" href="/dashboard/projects/">← 프로젝트 목록</a><h1>{p?'프로젝트 편집':'어떤 작업을 만들었나요?'}</h1><p>팀의 결과와 내가 기여한 부분을 나누어 적어 주세요.</p></header><section class="panel project-editor"><ImageUpload target="project-images" multiple /><form method="post" action="/api/project/" data-api="project" data-track class="form-stack"><input type="hidden" name="id" value={p?.id||''} /><input type="hidden" name="version" value={p?.updated_at||''} /><input type="hidden" id="project-images" name="image_ids" value={p?.image_ids.join(',')||''} /><ul class="selected-images" id="image-selection">{(p?.image_ids||[]).map((id:string)=><li data-asset={id}><img src={`/media/${id}/?handle=${info.profile.handle}`} alt={info.assets.find(a=>a.id===id)?.alt||'선택한 이미지'} width="144" height="96" /><button type="button" class="text-button" data-remove-image={id}>제외</button></li>)}</ul><label>프로젝트 이름<input name="title" value={p?.title||''} required maxlength="200" /></label>{isNew&&<label>주소 이름<input name="slug" pattern="[a-z0-9][a-z0-9-]{0,99}" maxlength="100" placeholder="비워 두면 자동 생성됩니다" /><span class="help">영문 소문자·숫자·하이픈. 저장 후에는 바뀌지 않습니다.</span></label>}<label>한 줄 설명<textarea aria-label="한 줄 설명" name="summary" rows="2" maxlength="1000">{p?.summary||''}</textarea></label><div class="field-pair"><label>맡은 역할<input name="role" value={p?.role||''} maxlength="200" placeholder="백엔드 개발 · API 설계" /></label><label>기간<input name="period" value={p?.period||''} maxlength="120" placeholder="2026.03–2026.06" /></label></div><label>기술 태그<input name="tech" value={p?.tech.join(', ')||''} maxlength="600" placeholder="NestJS, PostgreSQL, Cloud Run" /><span class="help">쉼표로 구분 · 최대 12개, 각각 40자</span></label>{[['problem','해결하려던 문제','누구의 어떤 문제를 풀었나요?'],['contribution','내가 기여한 부분','팀에서 직접 설계·구현·확인한 부분은 무엇인가요?'],['approach','접근 방법','어떤 선택을 했고, 왜 그렇게 했나요?'],['result','결과','확인한 변화와 팀 전체 결과를 적어 주세요.']].map(([name,label,placeholder])=><label>{label}<textarea aria-label={label} name={name} rows="4" maxlength="10000" placeholder={placeholder}>{p?.[name]||''}</textarea></label>)}<details class="additional-body"><summary>상세 본문 (Markdown)</summary><label>추가 기록<textarea aria-label="추가 기록" name="body" rows="12" maxlength="200000">{p?.body||''}</textarea></label></details><label>결과물 링크<textarea aria-label="결과물 링크" name="links" rows="3" placeholder="GitHub | https://github.com/…">{p?.links.map((l:any)=>`${l.label} | ${l.url}`).join('\n')||''}</textarea><span class="help">한 줄에 하나씩 ‘이름 | URL’. 코드가 비공개라면 비워 두어도 됩니다.</span></label><fieldset><legend>게시 옵션</legend><label class="check"><input type="checkbox" name="included" checked={p?p.included:true} />포트폴리오에 포함</label><label class="check"><input type="checkbox" name="featured" checked={p?.featured||false} />대표 작업으로 먼저 보여주기</label><label class="check"><input type="checkbox" name="discoverable" checked={p?.discoverable||false} />탐색에 표시</label><p class="help">‘공개’ 포트폴리오에 게시한 작업만 탐색에 표시됩니다. 편집 중인 내용은 외부에 보이지 않습니다.</p></fieldset><p data-feedback class="feedback" role="status"></p><div class="sticky-actions"><button class="button" type="submit">프로젝트 저장</button><a class="outline" href="/dashboard/preview/" target="_blank" rel="noopener">미리보기 ↗</a></div></form>{p&&<form method="post" action="/api/delete-project/" data-api="delete-project" data-confirm="프로젝트 원본을 삭제할까요? 외부 게시본에서는 다시 게시한 후 제외됩니다."><input type="hidden" name="id" value={p.id} /><p data-feedback class="feedback" role="status"></p><button type="submit" class="danger-button">프로젝트 삭제</button></form>}</section></Shell>
