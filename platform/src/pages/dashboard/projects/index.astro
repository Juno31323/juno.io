---
import Shell from '../../../layouts/Shell.astro';
import {ownerData} from '../../../lib/server';
const info=await ownerData(Astro.locals.db!,Astro.locals.user!.id);if(!info.profile)return Astro.redirect('/dashboard/');
---
<Shell title="프로젝트 관리" dashboard noindex><header class="page-heading dashboard-heading"><div><span class="eyebrow">MY PROJECTS</span><h1>만든 것들</h1><p>내 역할과 결과물을 남겨 보세요. 저장한 뒤 게시하면 반영됩니다.</p></div><a class="button" href="/dashboard/projects/new/">프로젝트 등록 +</a></header>{info.projects.length?<form method="post" action="/api/order/" data-api="order" data-track><input type="hidden" name="ids" value={info.projects.map(p=>p.id).join(',')} /><ul class="managed-projects" data-project-order>{info.projects.map((p:any)=><li class="order-item panel" data-id={p.id}><div><div class="tags">{p.featured&&<span>대표 작업</span>}<span>{p.included?'포트폴리오에 포함':'게시에서 제외'}</span><span>{p.discoverable?'탐색 허용':'탐색 숨김'}</span></div><h2><a href={`/dashboard/projects/${p.id}/`}>{p.title}</a></h2><p>{p.summary}</p><span class="help">{p.role}</span></div><div class="order-actions"><button type="button" class="outline" data-move="up" aria-label={`${p.title} 위로`}>↑</button><button type="button" class="outline" data-move="down" aria-label={`${p.title} 아래로`}>↓</button><a class="outline" href={`/dashboard/projects/${p.id}/`}>편집</a></div></li>)}</ul><p data-feedback class="feedback" role="status"></p><button class="button" type="submit">순서 저장</button></form>:<section class="empty-state panel"><h2>첫 프로젝트를 남겨 보세요.</h2><p>이미지나 공개 코드가 없어도 등록할 수 있습니다.</p><a class="outline" href="/dashboard/projects/new/">프로젝트 등록</a></section>}</Shell>
