---
import Shell from '../../layouts/Shell.astro';
import ProjectCard from '../../components/ProjectCard.astro';
const q=(Astro.url.searchParams.get('q')||'').slice(0,100),tech=(Astro.url.searchParams.get('tech')||'').slice(0,40),role=(Astro.url.searchParams.get('role')||'').slice(0,100),page=Math.max(0,Math.min(10000,Number(Astro.url.searchParams.get('page'))||0));
let items:any[]=[],facets:string[]=[],failed=false;
if(Astro.locals.db){const [result,filters]=await Promise.all([Astro.locals.db.rpc('pf_search',{p_query:q,p_tech:tech,p_role:role,p_page:page}),Astro.locals.db.rpc('pf_facets')]);items=result.data||[];facets=filters.data?.tech||[];failed=Boolean(result.error);}else failed=true;
const pageUrl=(value:number)=>{const params=new URLSearchParams({q,tech,role,page:String(value)});return`/explore/?${params}`;};
---
<Shell title="작업 탐색"><header class="page-heading"><span class="eyebrow">EXPLORE PROJECTS</span><h1>작업을 통해, 사람을 발견하세요.</h1><p>작성자가 탐색 공개를 선택한 프로젝트를 모았습니다.</p></header><form method="get" action="/explore/" class="explore-filters"><label>키워드<input name="q" value={q} placeholder="학교 공지 챗봇, NestJS…" maxlength="100" /></label><label>기술<select name="tech"><option value="">모든 기술</option>{facets.map(value=><option value={value} selected={value===tech}>{value}</option>)}</select></label><label>역할<input name="role" value={role} placeholder="백엔드, 디자인…" maxlength="100" /></label><button class="button" type="submit">검색</button><a href="/explore/" class="text-button">초기화</a></form>
{failed?<section class="empty-state"><h2>작업을 불러오지 못했습니다.</h2><p>잠시 후 다시 시도해 주세요.</p><a href={Astro.url.pathname+Astro.url.search} class="outline">다시 시도</a></section>:items.length?<><div class="explore-topline"><span>{q||tech||role?'검색 결과':'공개 프로젝트'}</span><span>{page+1} 페이지</span></div><div class="project-grid explore-grid">{items.slice(0,12).map(item=><ProjectCard project={item.project} name={item.name} handle={item.handle} href={`/explore/${item.project.id}/`} />)}</div><nav class="pagination" aria-label="검색 결과 페이지">{page>0&&<a class="outline" href={pageUrl(page-1)}>이전</a>}{items.length>12&&<a class="outline" href={pageUrl(page+1)}>다음</a>}</nav></>:<section class="empty-state"><h2>{q||tech||role?'조건에 맞는 작업이 없습니다.':'아직 탐색에 공개된 작업이 없습니다.'}</h2><p>{q||tech||role?'다른 키워드나 기술로 찾아보세요.':'첫 작업을 등록하고 공개해 보세요.'}</p><a class="outline" href={q||tech||role?'/explore/':'/signup/'}>{q||tech||role?'조건 지우기':'내 페이지 만들기'}</a></section>}</Shell>
