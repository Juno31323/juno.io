---
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import { getWorks, workHref } from '../lib/works';
import { profile } from '../data/profile';
import { projectArt } from '../data/project-art';
const works = (await getWorks()).filter(work => work.data.featured).slice(0, 3);
---
<BaseLayout>
  <div class="home-opening hero">
    <section class="profile-summary" aria-labelledby="hero-title">
      {profile.photo && <figure class="hero-portrait"><img src="/images/portfolio/portrait.webp" alt={profile.photo.alt} width="1281" height="1227" fetchpriority="high" decoding="async" /></figure>}
      <h1 id="hero-title" class="marked-heading">{profile.name}</h1>
      <div class="hero-intro"><p>{profile.intro.replace(', ', ',\n')}</p></div>
      <p class="profile-school">{profile.school}<br class="mobile-only" /> 인공지능소프트웨어학과</p>
      <div class="hero-links">
        <a class="button-link" href="/projects/">만든 것들 <Arrow /></a>
        <a class="outline-link" href="https://github.com/Juno31323" target="_blank" rel="noopener noreferrer">GitHub <Arrow direction="external" /></a>
      </div>
    </section>
    <section id="selected-work" class="home-work-panel" aria-labelledby="selected-work-title">
      <h2 id="selected-work-title" class="marked-heading">만든 것들</h2>
      <ul class="home-work-list">
        {works.map((work, index) => {
          const art = projectArt[work.id as keyof typeof projectArt];
          return <li><a class:list={['work-row', 'home-work', { 'home-work-featured': index === 0 }]} href={workHref(work)}>
            {art && <img class="home-work-art" src={art.src} alt={art.alt} width={art.width} height={art.height} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />}
            <div class="home-work-copy"><h3>{work.data.title}</h3><p>{art?.subtitle ?? work.data.summary}</p></div>
            <span class="work-arrow"><Arrow /></span>
          </a></li>;
        })}
      </ul>
    </section>
  </div>
  <section class="research-ribbon" aria-labelledby="research-title">
    <h2 id="research-title" class="marked-heading">연구와 발표</h2>
    <p>OCR · 하이브리드 검색 · 검색 평가</p>
    <a class="outline-link" href="/research/university-notice-rag/">연구 상세 <Arrow /></a>
  </section>
  <div class="home-notes section-block">
    <section class="research-summary" aria-labelledby="rag-title">
      <h2 id="rag-title">대학 공지 RAG, Chat2B-AU</h2>
      <p>49개 문항으로 OCR과 레이아웃에 따른 검색 성능을 비교했습니다.</p>
      <dl class="research-results"><div><dt>텍스트 전용 Recall@5</dt><dd>67.35%</dd></div><div><dt>OCR 추가 Recall@5</dt><dd>89.80%</dd></div></dl>
      <p class="research-caveat">동일 필드·청크 배정에서는 레이아웃 표현의 추가 이점을 확인하지 못했습니다.</p>
      <a class="text-link" href="/research/">연구 기록 읽기 <Arrow /></a>
    </section>
    <section class="interests" aria-labelledby="interests-title">
      <h2 id="interests-title">관심과 학습 계획</h2>
      <ul class="interest-list"><li><h3>RAG·정보검색</h3><p>OCR · 하이브리드 검색 · 검색 평가</p></li><li><h3>AI 시스템·MLOps</h3><p>운영·배포</p></li><li><h3>다음 공부</h3><p>SQLD · C · C++ · Rust</p></li></ul>
    </section>
  </div>
</BaseLayout>
