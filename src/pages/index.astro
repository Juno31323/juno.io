---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import { getWorks, workHref } from '../lib/works';
import { profile } from '../data/profile';
import FirezoneFlow from '../components/FirezoneFlow.astro';
import ResearchMetrics from '../components/ResearchMetrics.astro';
import { workKeywords } from '../lib/work-keywords';
import '../styles/portfolio-home.css';

const works = (await getWorks()).filter(work => work.data.featured).slice(0, 3);
const timeline = (await getCollection('timeline')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const focus = [
  { name: '백엔드', stack: 'NestJS · Spring Boot', href: '/projects/shared-auth-api/' },
  { name: '앱 개발', stack: 'React Native · 공공데이터', href: '/projects/firezone/' },
  { name: 'RAG 연구', stack: 'pgvector · OCR', href: '#research' },
];
---
<BaseLayout>
  <section class="portfolio-hero" aria-labelledby="hero-title">
    <div class="hero-main" data-enter>
      <div class="hero-copy">
        <p class="index-label">개발 포트폴리오</p>
        <h1 id="hero-title">{profile.name}</h1>
        <div class="hero-intro"><p>{profile.intro}</p></div>
        <p class="profile-school">{profile.school} 인공지능소프트웨어학과</p>
        <div class="hero-links">
          <a class="button-link" href="#selected-work">대표 작업 보기 <Arrow direction="down" /></a>
          <a class="outline-link" href={profile.links[0].url} target="_blank" rel="noopener noreferrer">GitHub <Arrow direction="external" /></a>
        </div>
      </div>
      {profile.photo && <figure class="hero-portrait"><img src="/images/portfolio/portrait.webp" alt={profile.photo.alt} width="1281" height="1227" fetchpriority="high" decoding="async" /></figure>}
    </div>
    <ul class="focus-index" aria-label="주요 분야">
      {focus.map((item, i) => <li><a href={item.href}><span class="index-label" aria-hidden="true">0{i + 1}</span><span class="focus-copy"><strong>{item.name}</strong><small>{item.stack}</small></span><Arrow direction={item.href.startsWith('#') ? 'down' : 'right'} /></a></li>)}
    </ul>
  </section>

  <section class="work-section portfolio-section" id="selected-work" aria-labelledby="selected-work-title">
    <div class="section-intro"><div><p class="index-label" lang="en">01 / SELECTED WORK</p><h2 id="selected-work-title">대표 작업</h2></div><a class="text-link" href="/projects/">모든 프로젝트 <Arrow /></a></div>
    <ul class="featured-works" data-featured-works>
      {works.map((work, index) => {
        const tags = workKeywords(work.data.listRole, work.id);
        return <li class:list={{ 'feature-lead': index === 0 }}><a class="feature-card" href={workHref(work)}>
          <div class="feature-copy">
            <p class="feature-category">{work.data.category}</p>
            <div class="feature-title"><h3>{work.data.title}</h3><Arrow direction="external" /></div>
            {work.data.summary && <p class="feature-summary">{work.data.summary}</p>}
            {tags.length > 0 && <ul class="keyword-list" aria-label="기술">{tags.map(tag => <li>{tag}</li>)}</ul>}
          </div>
          {work.id === 'firezone' && <FirezoneFlow />}
        </a></li>;
      })}
    </ul>
    <template data-firezone-flow><FirezoneFlow /></template>
    <p class="dashboard-empty" data-featured-empty hidden>등록된 대표 작업이 없습니다.</p>
  </section>

  <div class="portfolio-section notes-grid">
    <section id="research" class="research-section" aria-labelledby="research-title">
      <div class="section-intro"><div><p class="index-label" lang="en">02 / RESEARCH</p><h2 id="research-title">연구 노트</h2></div><a class="text-link" href="/research/">연구 목록 <Arrow /></a></div>
      <div class="research-feature">
        <div class="research-summary">
          <h3>대학 공지 RAG · Chat2B-AU</h3>
          <p>49개 문항으로 OCR과 레이아웃에 따른 검색 성능을 비교했습니다.</p>
          <ul class="keyword-list" aria-label="연구 키워드"><li>OCR</li><li>하이브리드 검색</li><li>Recall@5</li></ul>
          <a class="text-link" href="/research/university-notice-rag/">연구 상세 <Arrow /></a>
        </div>
        <ResearchMetrics />
      </div>
    </section>

    <div class="note-stream">
      <section aria-labelledby="posts-title">
        <div class="section-intro"><div><p class="index-label" lang="en">03 / WRITING</p><h2 id="posts-title">최근 글</h2></div><a class="text-link" href="/blog/">모든 글 <Arrow /></a></div>
        <p class="dashboard-empty" data-home-posts-status role="status">최근 글을 불러오는 중입니다.</p>
        <ul class="dashboard-post-list" data-home-posts></ul>
        <noscript><style>[data-home-posts-status] { display:none }</style><p class="dashboard-empty">글 목록에서 읽을 수 있습니다.</p></noscript>
      </section>
      <section aria-labelledby="timeline-title">
        <div class="section-intro"><div><p class="index-label" lang="en">04 / EXPERIENCE</p><h2 id="timeline-title">최근 이력</h2></div><a class="text-link" href="/timeline/">전체 이력 <Arrow /></a></div>
        <ol class="dashboard-timeline-list">{timeline.map(item => <li><a href="/timeline/"><span class="note-date">{item.data.period}</span><h3>{item.data.title}</h3><span class="note-category">{item.data.category}</span></a></li>)}</ol>
      </section>
    </div>
  </div>
  <section class="learning-strip interests" aria-labelledby="interests-title">
    <h2 id="interests-title">관심과 학습</h2>
    <ul class="interest-list"><li><h3>RAG·정보검색</h3><p>OCR · 하이브리드 검색 · 검색 평가</p></li><li><h3>AI 시스템·MLOps</h3><p>운영·배포</p></li><li><h3>다음 공부</h3><p>SQLD · C · C++ · Rust</p></li></ul>
  </section>
</BaseLayout>
