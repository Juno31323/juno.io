---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
const entries = (await getCollection('timeline')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(entries.map(async entry => ({ entry, ...(await render(entry)) })));
---
<BaseLayout title="전체 이력" description="민준호의 학력·개발 교육·부트캠프·교내 활동과 자격시험 이력.">
  <header class="page-header"><h1>전체 이력<span class="accent-dot">.</span></h1></header>
  <ol class="timeline-list">{rendered.map(({ entry, Content }) => <li><span class="timeline-period">{entry.data.period === '시기 미기재' ? '행사' : entry.data.period.split('–').map((part, i) => <span>{i ? '– ' : ''}{part}</span>)}</span><div><h2>{entry.data.title}</h2><span class="work-category">{entry.data.category}</span><div class="prose"><Content /></div></div></li>)}</ol>
  <div class="detail-end"><a class="text-link" href="/projects/">프로젝트 <Arrow /></a></div>
</BaseLayout>
