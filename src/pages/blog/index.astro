---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/cms.css';
import '../../styles/writing.css';
---
<BaseLayout title="글" description="개발하며 남긴 메모와 연구 기록.">
  <header class="page-header blog-heading"><div><span class="eyebrow">DEVELOPMENT JOURNAL</span><h1>글<span class="accent-dot">.</span></h1><p class="page-lead">만들면서 배운 것들을 기록합니다.</p></div><a class="outline-link" href="/admin/">글 쓰기</a></header>
  <section class="blog-content" data-blog aria-label="글 목록">
    <div class="blog-toolbar"><div class="blog-tabs" role="group" aria-label="글 보기"><button type="button" data-blog-view="posts" aria-pressed="true">모든 글</button><button type="button" data-blog-view="series" aria-pressed="false">시리즈</button></div><label class="search-field">글 검색<input type="search" id="blog-search" placeholder="제목, 요약, 태그 검색" maxlength="100" /></label></div>
    <div class="blog-layout"><aside class="blog-filters" aria-label="글 필터"><h2>태그</h2><div data-blog-tags class="tag-filters"></div><label class="search-field">시리즈<select id="blog-series"><option value="">전체 시리즈</option></select></label><label class="search-field">정렬<select id="blog-sort"><option value="latest">최신순</option><option value="oldest">오래된순</option></select></label><button type="button" class="reset-filters" data-blog-reset>필터 초기화</button></aside><div class="blog-results"><p data-blog-count class="cms-help"></p>
    <p class="cms-feedback" data-blog-status role="status">글을 불러오는 중입니다.</p>
    <ul class="blog-list" data-blog-list></ul>
    <ul class="series-list" data-blog-series-list hidden></ul>
    <button class="outline-link" data-blog-more hidden>더 보기</button>
    </div></div>
    <noscript><p>글 목록을 보려면 JavaScript를 켜 주세요.</p></noscript>
  </section>
</BaseLayout>
