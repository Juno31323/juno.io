---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkList from '../../components/WorkList.astro';
import ResearchMetrics from '../../components/ResearchMetrics.astro';
import { liveWork } from '../../lib/works';
import { liveContent, publicEntries } from '../../lib/server/public-post';
const live = import.meta.env.PUBLIC_BLOG_CLEAN_URLS === 'true';
const current = live ? await liveContent(Astro.response, () => publicEntries(['research'])) : null;
const works = live ? (current || []).map(liveWork) : (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="연구와 발표" description="Chat2B-AU와 대학 공지 문서의 OCR·레이아웃 구조화에 따른 검색 성능 분석.">
  <header class="page-header"><p class="page-index" lang="en">RESEARCH</p><h1>연구와 발표</h1><p class="page-lead">대학 공지 RAG · OCR · 검색 평가</p></header>
  <section class="research-index" aria-label="연구 기록">{live && !works.length ? <p>{current ? '공개된 연구가 없습니다.' : '연구를 표시할 수 없습니다. 잠시 후 다시 시도해 주세요.'}</p> : <WorkList works={works} />}
    {works.some(work => work.id === 'university-notice-rag') && <ResearchMetrics />}
  </section>
</BaseLayout>
