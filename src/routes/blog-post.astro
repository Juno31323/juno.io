---
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryReader from '../components/EntryReader.astro';
import { blogPostUrl, localUrl } from '../lib/cms';
import { coverOf } from '../lib/blog';
import { findPublicPost, renderPost } from '../lib/server/public-post';

Astro.response.headers.set('Cache-Control', 'no-store');
let unavailable = false;
const post = await findPublicPost(Astro.params.slug).catch(() => {
  unavailable = true;
  return null;
});
if (!post) {
  Astro.response.status = unavailable ? 503 : 404;
  if (unavailable) Astro.response.headers.set('Retry-After', '30');
}
const title = post?.title || (unavailable ? '글을 불러오지 못했습니다.' : '공개된 글이 없습니다.');
const canonical = post ? new URL(blogPostUrl(post.slug), Astro.site || Astro.url).href : undefined;
const cover = post && coverOf(post);
---
<BaseLayout title={title} description={post?.summary || title} noindex={!post} canonical={canonical} image={cover ? new URL(cover, Astro.site || Astro.url).href : undefined}>
  {post ? <EntryReader entry={post} html={renderPost(post.body)} /> : <section class="not-found">
    <h1>{title}</h1>
    <p>{unavailable ? '잠시 후 다시 시도해 주세요.' : '주소를 확인하거나 블로그에서 다른 글을 골라 주세요.'}</p>
    <a class="button-link" href={localUrl('/blog/')}>글 목록으로</a>
  </section>}
</BaseLayout>
