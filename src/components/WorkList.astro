---
import Arrow from './Arrow.astro';
import { workHref, type WorkCard } from '../lib/works';
import { workKeywords } from '../lib/work-keywords';
interface Props { works: WorkCard[]; }
const { works } = Astro.props;
---
<ul class="work-list">
  {works.map(work => {
    const tags = workKeywords(work.data.listRole, work.id);
    return (
    <li>
      <a class="work-row" href={workHref(work)}>
        <div class="work-main"><h2>{work.data.title}</h2>{work.data.showSummary && <p>{work.data.summary}</p>}{tags.length > 0 && <ul class="keyword-list" aria-label="기술">{tags.map(tag => <li>{tag}</li>)}</ul>}</div>
        <div class="work-meta"><span class="work-category">{work.data.category}</span>{work.data.status && <span>{work.data.status}</span>}{work.data.period && <span>{work.data.period}</span>}</div>
        <span class="work-arrow"><Arrow /></span>
      </a>
    </li>
    );
  })}
</ul>
