---
import { render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import FirezoneFlow from '../components/FirezoneFlow.astro';
import { workKeywords } from '../lib/work-keywords';
import type { Work, WorkCard } from '../lib/works';
interface Props { work: WorkCard; fallback?: Work; html?: string; }
const { work, fallback, html } = Astro.props;
const Content = fallback ? (await render(fallback)).Content : null;
const isResearch = work.collection === 'research';
const tags = workKeywords(work.data.listRole, work.id);
---
<BaseLayout title={work.data.title} description={work.data.summary}>
  <header class="detail-header" data-work-id={work.id} data-work-kind={work.collection}>
    <a class="back-link" href={isResearch ? '/research/' : '/projects/'}><Arrow direction="left" /> {isResearch ? '연구와 발표' : '만든 것들'}</a>
    <h1>{work.data.title}</h1>
    <p class="detail-summary">{work.data.summary}</p>
    <ul class="keyword-list" data-detail-keywords aria-label="기술" hidden={!tags.length}>{tags.map(tag => <li>{tag}</li>)}</ul>
    <dl class="detail-meta"><div><dt>분야</dt><dd>{work.data.category}</dd></div><div><dt>맡은 일</dt><dd>{work.data.role}</dd></div>{work.data.period && <div><dt>기간</dt><dd>{work.data.period}</dd></div>}{work.data.status && <div><dt>상태</dt><dd>{work.data.status}</dd></div>}</dl>
    <div class="resource-links" data-work-links aria-label="관련 자료" hidden={!work.data.links.length}>{work.data.links.map(link => <a class="outline-link" href={link.url} target="_blank" rel="noopener noreferrer">{link.label}<Arrow direction="external" /></a>)}</div>
  </header>
  {!isResearch && work.id === 'firezone' && <div class="work-feature"><FirezoneFlow /></div>}
  {work.data.image && <figure class="work-image"><img src={work.data.image.src} alt={work.data.image.alt} /></figure>}
  <div class="article-layout work-article">{Content ? <article class="prose"><Content /></article> : <article class="prose" set:html={html || ''} />}</div>
  <div class="detail-end"><a class="text-link" href="/projects/">전체 프로젝트 <Arrow /></a></div>
</BaseLayout>
